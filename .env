# Environment configuration consumed by compose.yaml via ${VAR} substitution.
# Committed on purpose: it holds no real secrets, only local container defaults.

# ---- Resource Service database ----
RESOURCE_DB_NAME=resource_db
RESOURCE_DB_USER=postgres
RESOURCE_DB_PASSWORD=postgres

# ---- Song Service database ----
SONG_DB_NAME=song_db
SONG_DB_USER=postgres
SONG_DB_PASSWORD=postgres

# ---- JDBC URLs (services reach the databases by compose service name) ----
RESOURCE_DB_URL=jdbc:postgresql://resource-db:5432/resource_db
SONG_DB_URL=jdbc:postgresql://song-db:5432/song_db

# ---- Eureka service registry (clients register and discover here) ----
# resource-service reaches song-service through Eureka by its logical name,
# so no fixed inter-service URL is needed anymore.
EUREKA_URL=http://eureka-server:8761/eureka

# In Docker, each service registers its own container IP (distinct, reachable
# instances when song-service is scaled). Locally this var is unset, so services
# fall back to registering as "localhost" (reachable via loopback on any network).
EUREKA_PREFER_IP_ADDRESS=true

# ---- S3 object storage (LocalStack emulator) ----
# In Docker, resource-service reaches LocalStack by its compose service name.
# Locally (app on the host) it falls back to http://localhost:4566 via the
# application.yaml defaults added in ST-2. The emulator accepts any credentials;
# these dummy values hold no real secret and are committed on purpose.
S3_ENDPOINT=http://localstack:4566
S3_REGION=us-east-1
S3_BUCKET=resource-files
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_PATH_STYLE=true
